{
  "name": "antigravity-hud",
  "version": "1.0.0",
  "description": "Structured 2-line Antigravity CLI statusline HUD for subscription accounts with dual quota telemetry",
  "main": "bin/hud.js",
  "bin": {
    "antigravity-hud": "bin/hud.js"
  },
  "scripts": {
    "start": "node bin/hud.js",
    "test": "node tests/test.js && node tests/installer-test.js && node tests/release-check-test.js",
    "test:unit": "node tests/test.js",
    "test:installer": "node tests/installer-test.js",
    "test:release": "node tests/release-check-test.js",
    "release:check": "node scripts/release-check.js",
    "install:hud": "node scripts/install.js",
    "uninstall:hud": "node scripts/install.js --uninstall"
  },
  "keywords": [
    "antigravity",
    "antigravity-cli",
    "statusline",
    "hud",
    "gemini",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gottematias/antigravity-hud.git"
  },
  "bugs": {
    "url": "https://github.com/gottematias/antigravity-hud/issues"
  },
  "homepage": "https://github.com/gottematias/antigravity-hud#readme",
  "author": "gottematias",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
